{
  "name": "exportlite",
  "version": "0.0.0-prototype.1",
  "private": true,
  "description": "SQLite-native streaming JSON and CSV exports — experimental prototype",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./turso": {
      "import": {
        "types": "./dist/turso.d.mts",
        "default": "./dist/turso.mjs"
      },
      "require": {
        "types": "./dist/turso.d.cts",
        "default": "./dist/turso.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.mts",
        "default": "./dist/drizzle.mjs"
      },
      "require": {
        "types": "./dist/drizzle.d.cts",
        "default": "./dist/drizzle.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "check": "biome check .",
    "format": "biome check --write .",
    "bench": "node benchmarks/run.mjs",
    "example": "node examples/basic.mjs"
  },
  "peerDependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@libsql/client": "0.18.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0",
    "@types/zip-stream": "7.0.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "drizzle-orm": "0.45.4",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "zip-stream": "7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-ervin05/exportlite.git",
    "directory": "exportlite"
  },
  "homepage": "https://github.com/joe-ervin05/exportlite/tree/main/exportlite#readme",
  "bugs": {
    "url": "https://github.com/joe-ervin05/exportlite/issues"
  }
}
