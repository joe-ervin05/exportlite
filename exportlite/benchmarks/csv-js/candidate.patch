diff --git a/exportlite/src/database/csv-js.ts b/exportlite/src/database/csv-js.ts
new file mode 100644
index 0000000..2642a1e
--- /dev/null
+++ b/exportlite/src/database/csv-js.ts
@@ -0,0 +1,35 @@
+import { ExportLiteError, sqliteError } from "../errors.js";
+import type { ReadStatement } from "./adapter.js";
+
+/** One raw result row becomes one CSV record; the existing writer buffers it. */
+export function* csvJsRows(
+  statement: ReadStatement,
+  args: unknown[],
+): Generator<string> {
+  try {
+    for (const row of statement.raw().iterate(...args)) {
+      if (!Array.isArray(row) || !row.length || row.length % 2)
+        throw new Error("Expected SQLite CSV scalar pairs.");
+      if (row[0] === "utf16")
+        throw new ExportLiteError(
+          "INVALID_OPTIONS",
+          "The database uses UTF-16. Set encoding to utf16le or utf16be for declared table exports; exported data remains UTF-8.",
+        );
+      const cells: string[] = [];
+      for (let index = 0; index < row.length; index += 2) {
+        const kind = row[index];
+        const value = row[index + 1];
+        if (kind === "null") cells.push("");
+        else if (typeof value !== "string")
+          throw new Error("Expected SQLite scalar text.");
+        else if (kind === "text")
+          cells.push(`"${value.replaceAll('"', '""')}"`);
+        else if (kind === "integer" || kind === "real") cells.push(value);
+        else throw new Error("Unsupported SQLite CSV value.");
+      }
+      yield cells.join(",");
+    }
+  } catch (error) {
+    throw sqliteError(error);
+  }
+}
diff --git a/exportlite/src/planner/csv-js.ts b/exportlite/src/planner/csv-js.ts
new file mode 100644
index 0000000..d6ffe33
--- /dev/null
+++ b/exportlite/src/planner/csv-js.ts
@@ -0,0 +1,14 @@
+/** Preserve SQLite scalar spelling/validation; JS only escapes and joins CSV. */
+export function csvJsSelection(values: readonly string[], utf8Guard = false) {
+  return values
+    .flatMap((value, index) => {
+      const kind = `typeof(${value})`;
+      return [
+        utf8Guard && index === 0
+          ? `CASE WHEN length(CAST(char(13, 10) AS BLOB)) = 2 THEN ${kind} ELSE 'utf16' END`
+          : kind,
+        `CASE ${kind} WHEN 'blob' THEN json_quote(${value}) ELSE CAST(${value} AS TEXT) END`,
+      ];
+    })
+    .join(", ");
+}
