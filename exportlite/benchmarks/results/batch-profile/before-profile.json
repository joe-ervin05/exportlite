  "sql": "WITH RECURSIVE \"__exportlite_batches\"(\"bounds\") AS (\n    SELECT json_array(min(\"key\"), max(\"key\"), count(*))\n    FROM (SELECT \"rowid\" AS \"key\" FROM main.\"users\" AS \"__exportlite_source\" ORDER BY \"rowid\" LIMIT 256)\n    UNION ALL\n    SELECT (\n      SELECT json_array(min(\"key\"), max(\"key\"), count(*))\n      FROM (SELECT \"rowid\" AS \"key\" FROM main.\"users\" AS \"__exportlite_source\"\n        WHERE \"rowid\" > json_extract(\"__exportlite_batches\".\"bounds\", '$[1]')\n        ORDER BY \"rowid\" LIMIT 256)\n    )\n    FROM \"__exportlite_batches\"\n    WHERE json_extract(\"bounds\", '$[2]') > 0\n  )\n  SELECT (\n    SELECT json_group_array(json_object('name', \"name\"))\n    FROM (SELECT \"name\" FROM main.\"users\" AS \"__exportlite_source\"\n      WHERE \"rowid\" BETWEEN json_extract(\"__exportlite_batches\".\"bounds\", '$[0]')\n        AND json_extract(\"__exportlite_batches\".\"bounds\", '$[1]')\n      ORDER BY \"rowid\")\n  ), json_extract(\"bounds\", '$[2]')\n  FROM \"__exportlite_batches\"\n  WHERE json_extract(\"bounds\", '$[2]') > 0"
}
