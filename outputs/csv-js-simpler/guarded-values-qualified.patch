diff --git a/exportlite/src/planner/csv-js.ts b/exportlite/src/planner/csv-js.ts
new file mode 100644
index 0000000..3f6dd2d
--- /dev/null
+++ b/exportlite/src/planner/csv-js.ts
@@ -0,0 +1,15 @@
+import type { SelectedField } from "./columns.js";
+/** One result value per cell. Numeric tokens preserve SQLite spelling. */
+export function csvJsSelection(values: readonly string[], utf8Guard = false, fields?: readonly SelectedField[]) {
+  return values.map((value, index) => {
+    const field = fields?.[index];
+    let cell: string;
+    if (field?.kind === "boolean")
+      cell = `CASE ${value} WHEN 0 THEN 'false' WHEN 1 THEN 'true' ELSE CASE WHEN ${value} IS NULL THEN NULL ELSE json('ExportLite: expected boolean 0 or 1') END END`;
+    else if (field?.kind === "json") cell = `json(${value})`;
+    else cell = `CASE typeof(${value}) WHEN 'integer' THEN CASE WHEN ${value} BETWEEN -9007199254740991 AND 9007199254740991 THEN ${value} ELSE CAST(CAST(${value} AS TEXT) AS BLOB) END WHEN 'real' THEN CAST(CAST(${value} AS TEXT) AS BLOB) WHEN 'blob' THEN json('ExportLite: BLOB values require an explicit conversion') ELSE ${value} END`;
+    return utf8Guard && index === 0
+      ? `CASE WHEN length(CAST(char(13, 10) AS BLOB)) = 2 THEN ${cell} ELSE X'00' END`
+      : cell;
+  }).join(", ");
+}
