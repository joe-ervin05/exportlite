diff --git a/exportlite/src/database/csv-js.ts b/exportlite/src/database/csv-js.ts
new file mode 100644
index 0000000..8b9632c
--- /dev/null
+++ b/exportlite/src/database/csv-js.ts
@@ -0,0 +1,36 @@
+import { ExportLiteError, sqliteError } from "../errors.js";
+import type { ReadStatement } from "./adapter.js";
+
+/** Experimental JS formatting. Ownership/backpressure remain in the writer. */
+export function* csvJsRows(statement: ReadStatement, args: unknown[], target = 65_536): Generator<[Buffer, number]> {
+  let parts: string[] = [], size = 0, count = 0, total = 0;
+  try {
+    for (const row of (statement as ReadStatement & { safeIntegers(toggle: boolean): ReadStatement }).safeIntegers(false).raw().iterate(...args)) {
+      if (!Array.isArray(row) || !row.length)
+        throw new Error("Expected SQLite CSV scalars.");
+      if (Buffer.isBuffer(row[0]) && row[0].length === 1 && row[0][0] === 0)
+        throw new ExportLiteError("INVALID_OPTIONS", "The database uses UTF-16. Set encoding to utf16le or utf16be for declared table exports; exported data remains UTF-8.");
+      let line = "";
+      for (let index = 0; index < row.length; index += 1) {
+        if (index) line += ",";
+        const value = row[index];
+        if (value === null) continue;
+        if (typeof value === "string") line += '"' + value.replaceAll('"', '""') + '"';
+        else if (typeof value === "number" || typeof value === "bigint") line += String(value);
+        else if (Buffer.isBuffer(value)) line += value.toString("utf8").replaceAll("\0", "");
+        else throw new Error("Unsupported SQLite CSV value.");
+      }
+      line += "\r\n";
+      parts.push(line);
+      size += Buffer.byteLength(line);
+      count++;
+      if (++total % 2048 === 0 || size >= target) {
+        const buffer = Buffer.from(parts.join(""), "utf8");
+        parts = []; size = 0;
+        const rows = count; count = 0;
+        yield [buffer, rows];
+      }
+    }
+    if (count) yield [Buffer.from(parts.join(""), "utf8"), count];
+  } catch (error) { throw sqliteError(error); }
+}
